{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "buildConfiguration": "Debug"
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE": "http://localhost:8888/.netlify/functions"
      }
    },
    "device": {
      "distribution": "internal",
      "ios": {
        "buildConfiguration": "Release"
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://findacoachtoday.com/.netlify/functions",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "187916773186-g5tbjsagtnie08i97hl5bbbtiqqufc3c.apps.googleusercontent.com"
      }
    },
    "preview": {
      "distribution": "store",
      "ios": {
        "buildConfiguration": "Release",
        "autoIncrement": true
      },
      "android": {
        "buildType": "app-bundle",
        "autoIncrement": true
      },
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://findacoachtoday.com/.netlify/functions",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "187916773186-g5tbjsagtnie08i97hl5bbbtiqqufc3c.apps.googleusercontent.com"
      }
    },
    "production": {
      "distribution": "store",
      "ios": {
        "buildConfiguration": "Release",
        "autoIncrement": true
      },
      "android": {
        "buildType": "app-bundle",
        "autoIncrement": true
      },
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://findacoachtoday.com/.netlify/functions",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "187916773186-g5tbjsagtnie08i97hl5bbbtiqqufc3c.apps.googleusercontent.com"
      }
    }
  },
  "submit": {
    "preview": {
      "ios": {
        "appleId": "REPLACE_WITH_YOUR_APPLE_ID_EMAIL",
        "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APP_ID",
        "appleTeamId": "4YHDGF6D8L"
      },
      "android": {
        "serviceAccountKeyPath": "REPLACE_WITH_PATH_TO_GOOGLE_SERVICE_ACCOUNT_JSON",
        "track": "internal"
      }
    },
    "production": {
      "ios": {
        "appleId": "REPLACE_WITH_YOUR_APPLE_ID_EMAIL",
        "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APP_ID",
        "appleTeamId": "4YHDGF6D8L"
      },
      "android": {
        "serviceAccountKeyPath": "REPLACE_WITH_PATH_TO_GOOGLE_SERVICE_ACCOUNT_JSON",
        "track": "production"
      }
    }
  }
}


