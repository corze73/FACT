{
  "name": "@fact/mobile",
  "private": true,
  "version": "0.0.0",
  "main": "index.js",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@fact/api": "0.0.0",
    "@fact/auth": "0.0.0",
    "@fact/config": "0.0.0",
    "@fact/domain": "0.0.0",
    "@fact/types": "0.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@types/react": "~19.2.10",
    "expo": "~55.0.15",
    "expo-document-picker": "~55.0.13",
    "expo-font": "~55.0.6",
    "expo-status-bar": "~55.0.5",
    "react": "19.2.0",
    "react-native": "0.83.4",
    "react-native-safe-area-context": "~5.6.2",
    "typescript": "~5.9.2"
  },
  "devDependencies": {
    "babel-preset-expo": "^55.0.17"
  },
  "scripts": {
    "dev": "expo start",
    "dev:client": "expo start --dev-client --tunnel",
    "dev:device": "node ./scripts/start-device.cjs",
    "dev:device:dev-client": "node ./scripts/start-device.cjs --dev-client",
    "dev:tunnel": "expo start --tunnel",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device 00008110-001C41500291401E --configuration Debug --no-bundler",
    "ios:simulator": "expo run:ios --device 10FF8D5A-CB06-4C2D-89D9-BD6E3A8F09A2",
    "android": "expo run:android",
    "web": "expo start --web",
    "ios:release": "xcodebuild -workspace ios/FACTMobile.xcworkspace -scheme FACTMobile -configuration Release -destination \"id=10FF8D5A-CB06-4C2D-89D9-BD6E3A8F09A2\" build",
    "ios:device-check": "xcodebuild -workspace ios/FACTMobile.xcworkspace -scheme FACTMobile -configuration Release -destination \"generic/platform=iOS\" build"
  }
}
