{
  "expo": {
    "name": "FACT Mobile",
    "slug": "fact-mobile",
    "scheme": "fact",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icon.png",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "FACT Mobile uses your local network during development to connect to the Metro bundler."
      },
      "bundleIdentifier": "com.findacoachtoday.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#08111f"
      },
      "package": "com.findacoachtoday.mobile"
    },
    "plugins": [],
    "experiments": {
      "typedRoutes": false
    }
  }
}