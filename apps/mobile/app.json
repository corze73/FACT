{
  "expo": {
    "name": "FACT Mobile",
    "slug": "fact-mobile",
    "scheme": "fact",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icon.png",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "FACT Mobile uses local network access to connect to nearby services.",
        "NSBonjourServices": [
          "_react-native._tcp",
          "_http._tcp"
        ]
      },
      "bundleIdentifier": "com.findacoachtoday.mobile",
      "scheme": "com.googleusercontent.apps.1061540997688-07hhmogi1sk7ctc3thmgrjh5ikq5l0ut"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#08111f"
      },
      "package": "com.findacoachtoday.mobile"
    },
    "plugins": [
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
