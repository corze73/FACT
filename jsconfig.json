{
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["apps/web/src/*"],
      "@fact/api": ["packages/api/src/index.ts"],
      "@fact/domain": ["packages/domain/src/index.ts"],
      "@fact/config": ["packages/config/src/index.ts"],
      "@fact/types": ["packages/types/src/index.ts"]
    },
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2020",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "typeAcquisition": {
    "enable": false
  },
  "include": ["apps/web/src/**/*", "packages/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "build"
  ]
}