#############################################
# FACT – Environment Configuration (.env)
#
# Server-only secrets (no VITE_ prefix) are used by Netlify Functions and
# local Node server. Client-safe values MUST be prefixed with VITE_.
#############################################

# --- Database (server-only) ---
# Production uses server APIs only. Avoid VITE_DATABASE_URL in prod builds.
DATABASE_URL=postgresql://username:password@host.neon.tech/database?sslmode=require
# Optional (dev-only): direct client DB access for local scripts/tests
VITE_DATABASE_URL=

# --- App / OAuth (client-safe) ---
VITE_APP_URL=http://localhost:5173
VITE_GOOGLE_CLIENT_ID=your-google-client-id.googleusercontent.com

# --- Stripe ---
# Server-only secrets
STRIPE_SECRET_KEY=sk_test_your_test_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# Client-safe publishable key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_test_publishable_key_here

# For production, replace with live keys:
# STRIPE_SECRET_KEY=sk_live_your_live_secret_key_here
# STRIPE_WEBHOOK_SECRET=whsec_your_live_webhook_secret_here
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_live_publishable_key_here

# --- Admin Fee (client-safe) ---
VITE_FIXED_ADMIN_FEE=300

# --- Email (server-only) ---
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Contact addresses (client-safe) ---
VITE_SUPPORT_EMAIL=
VITE_ADMIN_EMAIL=
