# Database configuration
# NOTE: DATABASE_URL must ONLY be used on the server (Netlify functions, Node).
# Do NOT expose it to the browser. For legacy dev-only flows you may set
# VITE_DATABASE_URL, but production builds should rely on server APIs only.
DATABASE_URL=postgresql://username:password@host.neon.tech/database?sslmode=require
VITE_DATABASE_URL=

# Google OAuth Configuration
VITE_GOOGLE_CLIENT_ID=your-google-client-id.googleusercontent.com

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_test_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_test_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# For production, replace with live keys:
# STRIPE_SECRET_KEY=sk_live_your_live_secret_key_here
# STRIPE_PUBLISHABLE_KEY=pk_live_your_live_publishable_key_here
# STRIPE_WEBHOOK_SECRET=whsec_your_live_webhook_secret_here

# App Configuration
VITE_APP_URL=http://localhost:5173
VITE_API_URL=http://localhost:3001

# Admin Fee Configuration (in pence/cents)
VITE_FIXED_ADMIN_FEE=300

# Stripe (server-side only)
# NEVER expose STRIPE_SECRET_KEY to the client
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

# Email (server-side only)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Contact addresses (safe to expose)
VITE_SUPPORT_EMAIL=
VITE_ADMIN_EMAIL=
